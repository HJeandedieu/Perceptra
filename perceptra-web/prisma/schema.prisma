// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// User â€” security operators who log into the dashboard
// ------------------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERATOR)
  notificationInApp Boolean @default(true)
  notificationDesktop Boolean @default(false)
  notificationSound Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  OPERATOR
}

// ------------------------------------------------------------------
// Person â€” registered individuals the AI engine recognises
// ------------------------------------------------------------------
model Person {
  id            String   @id @default(uuid())
  name          String
  role          String   // e.g. "staff", "student", "visitor"
  faceImageB64  String   // base64 encoded face image for FaceNet
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------------------
// Event â€” threat detection events posted by the AI engine
// ------------------------------------------------------------------
model Event {
  id             String   @id @default(uuid())
  eventId        String   @unique  // UUID from AI engine
  timestamp      DateTime
  label          String            // e.g. "person", "knife", "gun"
  confidence     Float
  bboxX1         Int
  bboxY1         Int
  bboxX2         Int
  bboxY2         Int
  severity       Severity
  threatScore    Float
  loiterSeconds  Float
  frameId        Int
  source         String   @default("ai_engine")
  identity       String?           // "registered" | "unknown" | null
  personName     String?           // matched person name if registered
  alertSent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([severity])
  @@index([timestamp])
  @@index([label])
}

enum Severity {
  low
  medium
  high
  critical
}
model Camera {
 id String @id @default("camera-01")
 name String @default("Main entrance")
 location String @default("")
 deviceIndex Int @default(0)
 deviceName String @default("onn 4K Webcam")
 monitoring Boolean @default(true)
 loiterSeconds Int @default(30)
 zone Json @default("[0,0,1,1]")
 health Json?
 lastHeartbeat DateTime?
 viewerUntil DateTime?
 version Int @default(1)
 updatedAt DateTime @updatedAt
 incidents Incident[]
}
model Incident {
 id String @id
 cameraId String
 camera Camera @relation(fields:[cameraId],references:[id])
 trackId String
 severity Severity
 status IncidentStatus @default(NEW)
 firstSeen DateTime
 lastSeen DateTime
 reason String
 metadata Json
 acknowledgedBy String?
 acknowledgedAt DateTime?
 resolvedBy String?
 resolvedAt DateTime?
 resolutionNote String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 activities IncidentActivity[]
 @@index([status,firstSeen])
}
model IncidentActivity {
 id String @id @default(uuid())
 incidentId String
 incident Incident @relation(fields:[incidentId],references:[id],onDelete:Cascade)
 actorId String?
 action String
 note String?
 createdAt DateTime @default(now())
}
model Delivery {
 id String @id
 createdAt DateTime @default(now())
}
enum IncidentStatus {
 NEW
 ACKNOWLEDGED
 RESOLVED
 FALSE_ALARM
}

model LoginRate {
 id String @id
 attempts Int @default(1)
 expiresAt DateTime
 @@index([expiresAt])
}
